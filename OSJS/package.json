{
  "name": "mcs-osjs-base-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Basic OS.js desktop shell for MCS.OSJS (donor-derived neutral shell,Nameless SCADA osjs-prototype). No SCADA applications or backend coupling.",
  "scripts": {
    "build:local-packages": "node scripts/build-local-packages.js",
    "build:manifest": "osjs-cli package:discover",
    "package:discover": "osjs-cli package:discover",
    "serve": "node src/server/index.js",
    "build": "webpack",
    "watch": "webpack --watch"
  },
  "license": "BSD-2-Clause",
  "dependencies": {
    "@babel/runtime": "^7.12.0",
    "@osjs/cli": "^3.1.3",
    "@osjs/client": "^3.7.1",
    "@osjs/dialogs": "^3.1.0",
    "@osjs/gnome-icons": "^4.0.5",
    "@osjs/gui": "^4.0.36",
    "@osjs/panels": "^3.0.31",
    "@osjs/server": "^3.2.3",
    "@osjs/standard-theme": "^4.0.9",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@babel/core": "^7.12.0",
    "@babel/plugin-transform-runtime": "^7.12.0",
    "@babel/preset-env": "^7.12.0",
    "babel-loader": "^8.1.0",
    "css-loader": "^3.6.0",
    "file-loader": "^5.1.0",
    "html-webpack-plugin": "^3.2.0",
    "jsdom": "^30.0.1",
    "mini-css-extract-plugin": "^0.9.0",
    "sass": "^1.32.13",
    "sass-loader": "^10.2.1",
    "webpack": "^4.44.2",
    "webpack-cli": "^3.3.12"
  },
  "engines": {
    "node": ">=10.0.0 <17"
  }
}